{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sf-plugin-data360:testbed:suite",
  "title": "Testbed scenario suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "mode", "steps"],
  "properties": {
    "name": { "type": "string" },
    "mode": { "enum": ["mock", "live"] },
    "description": { "type": "string" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "commands"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "tags": {
            "type": "array",
            "items": { "type": "string" },
            "description": "release-criteria refs + labels incl. destructive/billable gates"
          },
          "haltOnFail": { "type": "boolean", "default": false },
          "commands": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["argv", "expect"],
              "properties": {
                "argv": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "passed to `sf` (omit the bin)"
                },
                "stdin": { "type": "string" },
                "env": { "type": "object" },
                "expect": {
                  "type": "object",
                  "additionalProperties": false,
                  "oneOf": [{ "required": ["exitCode"] }, { "required": ["exitCodeOneOf"] }],
                  "properties": {
                    "exitCode": { "type": "integer" },
                    "exitCodeOneOf": { "type": "array", "items": { "type": "integer" } },
                    "jsonPath": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "additionalProperties": false,
                        "minProperties": 1,
                        "properties": { "exists": { "type": "boolean" }, "equals": {}, "matches": { "type": "string" } }
                      }
                    },
                    "stdoutIncludes": { "type": "array", "items": { "type": "string" } },
                    "stdoutExcludes": { "type": "array", "items": { "type": "string" } },
                    "stderrIncludes": { "type": "array", "items": { "type": "string" } },
                    "stderrExcludes": { "type": "array", "items": { "type": "string" } },
                    "maxDurationMs": { "type": "number" }
                  }
                },
                "httpExpect": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "count"],
                  "properties": {
                    "path": { "type": "string" },
                    "method": { "type": "string" },
                    "count": { "type": "integer", "minimum": 0 }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
