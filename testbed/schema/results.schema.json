{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sf-plugin-data360:testbed:results",
  "title": "Testbed step results (results.json)",
  "type": "object",
  "required": ["suites"],
  "additionalProperties": false,
  "properties": {
    "suites": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "required": ["title", "outcome", "commands"],
          "additionalProperties": false,
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "outcome": { "enum": ["pass", "fail", "blocked", "skipped"] },
            "commands": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["argv", "exitCode", "durationMs", "evidence"],
                "additionalProperties": false,
                "properties": {
                  "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                  "exitCode": { "type": "integer" },
                  "durationMs": { "type": "number", "minimum": 0 },
                  "evidence": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": { "type": "integer", "minimum": 0 }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
