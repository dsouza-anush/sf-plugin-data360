# Copy to .env.live. This example contains placeholders and non-secret API names only.
D360_LIVE_ORG=<approved-non-production-org>
D360_LIVE_FALLBACK_ORG=<approved-core-fallback-org>

# CI secret: configure in GitHub Actions, never in this file.
TESTKIT_AUTH_URL=<github-secret-only>

# Explicit safety gates. Change locally only after approval.
D360_LIVE_MUTATIONS=0
D360_LIVE_BILLABLE=0
D360_LIVE_SHARED_DATA=0

# Owner-approved, non-secret disposable or retained test resources.
D360_INGEST_SOURCE=<ingestion-source-api-name>
D360_INGEST_OBJECT=<source-object-api-name>
D360_STREAM_ID=<data-stream-id>
D360_STREAM_API_NAME=<data-stream-api-name>
D360_DLO_NAME=<data-lake-object-api-name>

# Local fixture paths and a query for the retained test object.
D360_INGEST_SAMPLE=<path-to-valid-json-or-ndjson>
D360_INGEST_INVALID_SAMPLE=<path-to-invalid-json>
D360_INGEST_CSV=<path-to-three-row-csv>
D360_INGEST_VERIFY_SQL=<approved-verification-query>
