{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sf-plugin-data360:schema:data360.dmo.relationship.create",
  "title": "data360.dmo.relationship.create JSON output",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "result", "warnings"],
  "properties": {
    "status": { "type": "integer" },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item"],
      "properties": {
        "item": {
          "type": "object",
          "additionalProperties": true,
          "required": ["relationships"],
          "properties": {
            "relationships": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "required": ["name"],
                "properties": { "name": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
