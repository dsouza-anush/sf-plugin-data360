{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sf-plugin-data360:schema:data360.doctor",
  "title": "data360.doctor JSON output",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "result", "warnings"],
  "properties": {
    "status": { "type": "integer" },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks"],
      "properties": {
        "checks": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status", "detail"],
            "properties": {
              "name": { "type": "string" },
              "status": { "enum": ["pass", "warn", "fail"] },
              "detail": { "type": "string" },
              "action": { "type": "string" }
            }
          }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
